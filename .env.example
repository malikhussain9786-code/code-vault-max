# Local dev only — in production on Vercel, leave this unset (frontend and backend
# share the same domain, so relative /api paths work automatically).
VITE_API_BASE_URL=http://localhost:4000

# Local dev server
PORT=4000
FRONTEND_ORIGIN=http://localhost:5173

# AI (Groq) — optional. Features (Write with AI, Explain, Find Errors, Fix, Improve,
# Document, Ask AI) work but report as unavailable if this is left blank. Free tier,
# no credit card needed: https://console.groq.com/keys
GROQ_API_KEY=
# Groq has deprecated models before (llama-3.1-8b-instant and llama-3.3-70b-versatile
# were both retired in June 2026) — if AI features ever fail with a "model not found"
# or "decommissioned" error, check https://console.groq.com/docs/models for the
# current recommended model and set it here. No code change needed.
GROQ_MODEL=openai/gpt-oss-120b

# There is no database and no server-side accounts in this build — accounts, snippets,
# and projects all live in the browser's localStorage. Nothing else to configure here.
